<Project>
  <!--
    Repeatable settings for a self-contained, single-file win-x64 release build.
    Kept out of the main .csproj so plain `dotnet build`/`dotnet test` (used by
    tests/Potentiostat.Web.Tests, which project-references this csproj) never pick
    up a RuntimeIdentifier or restore win-x64 runtime packs.
    Use: dotnet publish -p:PublishProfile=win-x64-selfcontained
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- MVC/SignalR/System.Text.Json rely on reflection; trimming can silently break them. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
